rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    //  CÓDIGO DE LA LIGA
    //  No está en el código: vive en Firestore, documento config/acceso,
    //  campo «pin» (texto). Nadie lo puede leer desde la app (ver match /config).
    //  Para cambiarlo: edita ese campo en la consola de Firebase. Todos los
    //  móviles tendrán que volver a meterlo una vez (el acceso antiguo caduca solo).
    // ==========================================================
    function pinActual() {
      return get(/databases/$(database)/documents/config/acceso).data.pin;
    }

    // Sesión iniciada con Google
    function signedIn() {
      return request.auth != null;
    }

    // Jugador ligado a esta cuenta (cada cuenta tiene una cara)
    function myPlayer() {
      return get(/databases/$(database)/documents/players/$(request.auth.uid)).data.player;
    }

    // Esta cuenta ha metido el código VIGENTE (si se cambia el código, deja de ser miembro)
    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/editors/$(request.auth.uid))
        && get(/databases/$(database)/documents/editors/$(request.auth.uid)).data.get('pin', '') == pinActual();
    }

    // Organizador: su uid se añade a mano en la consola (desde la web no se puede)
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /ping/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /config/{doc} {
      allow read, write: if false;
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Cada cara es de una sola cuenta: create() falla si ya está reservada
    match /claims/{pid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // La cuenta solo puede ligarse a la cara que acaba de reservar
    match /players/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && get(/databases/$(database)/documents/claims/$(request.resource.data.player)).data.uid == uid;
      allow update, delete: if false;
    }

    // Código correcto por cuenta. Hace falta haber elegido cara antes.
    match /editors/{uid} {
      allow read, delete: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pin'])
        && request.resource.data.pin is string
        && request.resource.data.pin.size() <= 40
        && exists(/databases/$(database)/documents/players/$(request.auth.uid))
        && request.resource.data.pin == pinActual();
    }

    // Partidos: se pueden ver y tocar con el PIN
    match /matches/{id} {
      allow read, write: if isMember();
    }

    // Pronósticos y votos: siempre a nombre de tu propio jugador
    match /preds/{id} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.v == myPlayer()
        && request.resource.data.w in ['a', 'b']
        && request.resource.data.r in ['20', '21'];
    }
    match /votes/{id} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.v == myPlayer()
        && request.resource.data.v != request.resource.data.c;
    }

    // Registro de cambios: solo se añade, y a tu nombre
    match /log/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasAll(['t', 'who', 'txt'])
        && request.resource.data.who == myPlayer();
      allow update, delete: if false;
    }

    // Móviles con avisos activados
    // Cada cuenta registra SU móvil (se hace antes del PIN); solo los miembros leen la lista
    match /push/{id} {
      allow read, delete: if isMember();
      allow create, update: if signedIn() && request.resource.data.who == myPlayer();
    }

    // AGENDA INTELIGENTE
    // Disponibilidad: la lee cualquier miembro; cada uno solo escribe la suya
    match /avail/{pid} {
      allow read: if isMember();
      allow create, update: if isMember() && myPlayer() == pid
        && request.resource.data.keys().hasOnly(['days', 'wk', 'we', 'marks', 'at'])
        && request.resource.data.days is list && request.resource.data.days.size() <= 7
        && request.resource.data.wk is list && request.resource.data.wk.size() <= 4
        && request.resource.data.we is list && request.resource.data.we.size() <= 4
        && request.resource.data.marks is map && request.resource.data.marks.size() <= 120;
      allow delete: if false;
    }
    // Propuestas de fecha de un partido (id «J6-pepe-joan»): solo los dos jugadores, y cada uno solo su lista
    match /plans/{mid} {
      allow read: if isMember();
      allow create, update: if isMember()
        && mid.split('-').size() == 3
        && (myPlayer() == mid.split('-')[1] || myPlayer() == mid.split('-')[2])
        && request.resource.data.keys().hasOnly(['picks', 'at'])
        && request.resource.data.picks is map
        && request.resource.data.picks.keys().hasOnly([mid.split('-')[1], mid.split('-')[2]])
        && (resource == null || request.resource.data.picks.diff(resource.data.get('picks', {})).affectedKeys().hasOnly([myPlayer()]))
        && request.resource.data.picks.get(myPlayer(), []).size() <= 12;
      allow delete: if false;
    }

    // Contador de entradas a la app (para el resumen de la ida): solo sumar 1 al total y a tu jugador
    match /stats/{doc} {
      allow read: if isMember();
      allow create: if isMember() && doc == 'opens'
        && request.resource.data.keys().hasOnly(['total', myPlayer()])
        && request.resource.data.total == 1 && request.resource.data[myPlayer()] == 1;
      allow update: if isMember() && doc == 'opens'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['total', myPlayer()])
        && request.resource.data.total == resource.data.total + 1
        && request.resource.data.get(myPlayer(), 0) == resource.data.get(myPlayer(), 0) + 1;
      allow delete: if false;
    }

    // ENCUESTAS: privadas. Solo las lee su jugador y el organizador (en agregado).
    match /surveys/{sid} {
      allow read: if isAdmin() || (signedIn() && resource.data.playerId == myPlayer());
      allow create: if isMember()
        && request.resource.data.status == 'pending'
        && sid == request.resource.data.matchId + '__' + request.resource.data.playerId;
      allow update: if signedIn()
        && resource.data.playerId == myPlayer()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'completed'
        && request.resource.data.playerId == resource.data.playerId
        && request.resource.data.matchId == resource.data.matchId
        && (!('comentario' in request.resource.data.answers) || request.resource.data.answers.comentario.size() <= 300);
      allow delete: if false;
    }
  }
}
